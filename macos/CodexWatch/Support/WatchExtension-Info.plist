<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Scribe Pilot Extension</string>
    <key>CLKComplicationPrincipalClass</key>
    <string>$(PRODUCT_MODULE_NAME).ScribePilotComplicationDataSource</string>
    <key>CLKComplicationSupportedFamilies</key>
    <array>
        <string>CLKComplicationFamilyGraphicCircular</string>
        <string>CLKComplicationFamilyGraphicRectangular</string>
        <string>CLKComplicationFamilyGraphicCorner</string>
        <string>CLKComplicationFamilyGraphicExtraLarge</string>
    </array>
    <key>CODEX_WATCH_RELAY_BASE_URL</key>
    <string>$(CODEX_WATCH_RELAY_BASE_URL)</string>
    <key>CODEX_WATCH_RELAY_TOKEN</key>
    <string>$(CODEX_WATCH_RELAY_TOKEN)</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Scribe Pilot uses the microphone to record audio for your private local transcription workflow.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionAttributes</key>
        <dict>
            <key>WKAppBundleIdentifier</key>
            <string>com.zachwyatt.codexwatch.watchkitapp</string>
        </dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.watchkit</string>
    </dict>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
